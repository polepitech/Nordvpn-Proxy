# NordVPN access token (Nord Account → NordVPN → Get access token)
NORDVPN_TOKEN=

# Exit country (fr, nl, de, ...)
COUNTRY=fr

# Uptime Kuma Push URL (without query string)
# Example: https://kuma.kraken-lab.fr/api/push/XXXXXXXX
KUMA_PUSH_URL=

# Healthcheck interval in milliseconds
CHECK_INTERVAL_MS=60000

# SOCKS proxy host from the healthcheck container (compose service name)
SOCKS_HOST=nord-proxy
SOCKS_PORT=1080
